# Pinned toolchain for the Potluck llama release builds.
# Read by .github/potluck/build.sh (locally and in .github/workflows/release.yml).
# Plain KEY=VALUE lines only: this file is sourced by bash and parsed by the workflow.
#
# Every value below is the one the hand-made production builds used; change a
# value only together with a note in docs/potluck-builds.md.

# linux-amd64-vulkan: Ubuntu 26.04 build image (glibc 2.43, GCC 15.2), the same
# release the consoles run. Digest of ubuntu:26.04 as used for the production
# build; packages from the Ubuntu archive snapshot of that day.
VULKAN_IMAGE=ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
VULKAN_APT_SNAPSHOT=20261120T000000Z
VULKAN_PACKAGES="git=1:2.53.0-1ubuntu1.1 cmake=4.2.3-2ubuntu2 ninja-build=1.13.2-1 g++=4:15.2.0-5ubuntu1 libvulkan-dev=1.4.341.0-1 glslc=2026.1-1 spirv-headers=1.6.1+1.4.341.0-1"
VULKAN_CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DLLAMA_USE_PREBUILT_UI=OFF -DGGML_RPC=ON -DGGML_VULKAN=ON -DGGML_CUDA=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF"

# linux-amd64-cuda: NVIDIA CUDA 13.3.1 devel image on Ubuntu 24.04 (glibc 2.39,
# GCC 13). Digest of nvidia/cuda:13.3.1-devel-ubuntu24.04 as used for the
# production build. The NVIDIA apt source is not used (nothing is installed from it).
CUDA_IMAGE=nvidia/cuda:13.3.1-devel-ubuntu24.04@sha256:4ff859525f99de5782aa73607ce24219b07dddd48d12b97c1c301d7e1cfb0a87
CUDA_APT_SNAPSHOT=20261120T000000Z
CUDA_PACKAGES="git=1:2.43.0-1ubuntu7.4 cmake=3.28.3-1build7 ninja-build=1.11.1-2 g++=4:13.2.0-7ubuntu1"
CUDA_CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DLLAMA_USE_PREBUILT_UI=OFF -DGGML_RPC=ON -DGGML_CUDA=ON -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DCMAKE_CUDA_ARCHITECTURES=86;89;120 -DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link=/usr/local/cuda/lib64/stubs -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs"
